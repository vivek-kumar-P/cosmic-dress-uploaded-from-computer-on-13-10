# dependencies
/node_modules
.pnpm-store
**/pnpm-lock.yaml
**/.pnpm-store/

# next.js
/.next/
/out/
.next/
.next-dev/
*.log

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
