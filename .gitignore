# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS artifacts
.DS_Store
Thumbs.db

# AI scratch (temporary working files — never commit)
.ai/scratch/*
!.ai/scratch/README.md
